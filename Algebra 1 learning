<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>YouTube Short Embed</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <style>
    /* Center on page */
    body{margin:0;min-height:100vh;display:grid;place-items:center;background:#0f1220}
    /* Portrait (9:16) container for Shorts */
    .player{
      width:min(420px, 92vw);
      aspect-ratio: 9 / 16;
      border-radius:12px; overflow:hidden;
      box-shadow: 0 10px 30px rgba(0,0,0,.35);
    }
    iframe{width:100%;height:100%;border:0}
  </style>
</head>
<body>
  <div class="player">
    <!-- Video ID from your link: ECfPJpVgARM -->
    <iframe
      src="https://www.youtube.com/embed/ECfPJpVgARM?modestbranding=1&rel=0&loop=1&playlist=ECfPJpVgARM"
      title="YouTube Short"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen>
    </iframe>
  </div>
</body>
</html>
